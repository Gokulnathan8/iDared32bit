*.iml
.gradle
/local.properties
.idea/
/build
/captures
.externalNativeBuild
.cxx
local.properties
android/app/src/main/jniLibs
android/app/build
android/build
android/.kotlin
# Signing keys and their details. Never commit these.
android/keystore.properties
*.jks
*.keystore

# macOS

.DS_Store

# Default developer dump file

DUMP.txt

