/target
/touchHLE_sandbox
/Saves
/DCIM
/touchHLE_apps
/Games/*
!/Games/README.txt
touchHLE_log.txt
touchHLE_log.previous.txt
touchHLE_wallpaper.*
/Log.txt
/Log.previous.txt
/Wallpaper.*

# Xcode Project (Modern/Deeply Nested)
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/.swiftpm/xcode/xcuserdata/
**/*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist
**/*.xcworkspace/xcshareddata/*.xccheckout
**/*.xcworkspace/xcshareddata/*.xcscmblueprint
**/*.playground/**/timeline.xctimeline

# Root (cargo-xcode-generated) project: opening it auto-generates scheme and
# workspace state that isn't meant to be shared. Only iphone/iDared32bit.xcodeproj
# has an intentionally-tracked shared scheme.
/touchHLE.xcodeproj/xcshareddata/

